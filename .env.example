# Canonical site origin used for metadata, sitemap, robots and OG URLs.
# Inlined at build time (NEXT_PUBLIC_*), so it must be set when building:
#   - Docker:  compose passes this file's value as a build arg automatically
#              when you name it `.env` next to docker-compose.yml
#   - Local:   `NEXT_PUBLIC_SITE_URL=https://quickqr.com npm run build`
# Must be an absolute URL; the scheme is optional (https:// is assumed).
# Empty or unparseable values fall back to the placeholder in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://quickqr.example.com
